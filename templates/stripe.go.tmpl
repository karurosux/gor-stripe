	"{{.Module}}/internal/auth"
	dbgen "{{.Module}}/internal/db/gen"
	"{{.Module}}/internal/httpx"
)

// Handler serves the /api/stripe endpoints.
type Handler struct {
	q *dbgen.Queries
}

// Register mounts the Stripe routes. The webhook stays public — Stripe
// authenticates it with the Stripe-Signature header — while the rest
// require a signed-in user.
func Register(g *echo.Group, q *dbgen.Queries) {
	stripesdk.Key = os.Getenv("STRIPE_SECRET_KEY")
	h := &Handler{q: q}
	g.POST("/stripe/webhook", h.Webhook)

	s := g.Group("/stripe", auth.Require)
	s.POST("/checkout", h.Checkout)
	s.POST("/portal", h.Portal)
	s.GET("/subscription", h.Subscription)
}

// appURL is where Checkout and the portal send the customer back to.
func appURL() string {
	if u := os.Getenv("APP_URL"); u != "" {
		return strings.TrimRight(u, "/")
	}
	return "http://localhost:5173"
}

// ensureCustomer returns the user's subscriptions row, creating the Stripe
// customer (and the row) on first use.
func (h *Handler) ensureCustomer(ctx context.Context, user *dbgen.User) (dbgen.Subscription, error) {
	sub, err := h.q.GetSubscriptionByUserID(ctx, user.ID)
	if err == nil {
		return sub, nil
	}
	if !errors.Is(err, pgx.ErrNoRows) {
		return dbgen.Subscription{}, err
	}
	params := &stripesdk.CustomerParams{
		Email: stripesdk.String(user.Email),
		Name:  stripesdk.String(user.Name),
	}
	params.AddMetadata("user_id", user.ID.String())
	cust, err := customer.New(params)
	if err != nil {
		return dbgen.Subscription{}, err
	}
	return h.q.UpsertSubscriptionCustomer(ctx, dbgen.UpsertSubscriptionCustomerParams{
		UserID:           user.ID,
		StripeCustomerID: cust.ID,
	})
}

// CheckoutInput is the POST /api/stripe/checkout request body. An empty
// priceId falls back to STRIPE_PRICE_ID.
type CheckoutInput struct {
	PriceID string `json:"priceId"`
}

// Checkout starts a subscription Checkout session and returns its URL for
// the frontend to redirect to.
func (h *Handler) Checkout(c echo.Context) error {
	var in CheckoutInput
	if err := httpx.Bind(c, &in); err != nil {
		return err
	}
	price := in.PriceID
	if price == "" {
		price = os.Getenv("STRIPE_PRICE_ID")
	}
	if price == "" {
		return echo.NewHTTPError(http.StatusBadRequest, "no price: pass priceId or set STRIPE_PRICE_ID")
	}

	sub, err := h.ensureCustomer(c.Request().Context(), auth.CurrentUser(c))
	if err != nil {
		return err
	}
	sess, err := session.New(&stripesdk.CheckoutSessionParams{
		Customer: stripesdk.String(sub.StripeCustomerID),
		Mode:     stripesdk.String(string(stripesdk.CheckoutSessionModeSubscription)),
		LineItems: []*stripesdk.CheckoutSessionLineItemParams{
			{Price: stripesdk.String(price), Quantity: stripesdk.Int64(1)},
		},
		SuccessURL: stripesdk.String(appURL() + "/billing?checkout=success"),
		CancelURL:  stripesdk.String(appURL() + "/billing?checkout=canceled"),
	})
	if err != nil {
		return err
	}
	return c.JSON(http.StatusOK, map[string]string{"url": sess.URL})
}

// Portal opens the Stripe billing portal, where customers manage payment
// methods, switch plans, and cancel.
func (h *Handler) Portal(c echo.Context) error {
	sub, err := h.ensureCustomer(c.Request().Context(), auth.CurrentUser(c))
	if err != nil {
		return err
	}
	sess, err := bpsession.New(&stripesdk.BillingPortalSessionParams{
		Customer:  stripesdk.String(sub.StripeCustomerID),
		ReturnURL: stripesdk.String(appURL() + "/billing"),
	})
	if err != nil {
		return err
	}
	return c.JSON(http.StatusOK, map[string]string{"url": sess.URL})
}

// SubscriptionResponse is what GET /api/stripe/subscription returns; status
// is "none" until a first checkout completes.
type SubscriptionResponse struct {
	Status            string     `json:"status"`
	PriceID           *string    `json:"priceId"`
	CurrentPeriodEnd  *time.Time `json:"currentPeriodEnd"`
	CancelAtPeriodEnd bool       `json:"cancelAtPeriodEnd"`
}

// Subscription reports the signed-in user's subscription state.
func (h *Handler) Subscription(c echo.Context) error {
	sub, err := h.q.GetSubscriptionByUserID(c.Request().Context(), auth.CurrentUser(c).ID)
	if errors.Is(err, pgx.ErrNoRows) {
		return c.JSON(http.StatusOK, SubscriptionResponse{Status: "none"})
	}
	if err != nil {
		return err
	}
	return c.JSON(http.StatusOK, SubscriptionResponse{
		Status:            sub.Status,
		PriceID:           sub.PriceID,
		CurrentPeriodEnd:  sub.CurrentPeriodEnd,
		CancelAtPeriodEnd: sub.CancelAtPeriodEnd,
	})
}

// Webhook is Stripe's callback. Point an endpoint at /api/stripe/webhook in
// the dashboard (or `stripe listen --forward-to localhost:8080/api/stripe/webhook`
// in dev) and set STRIPE_WEBHOOK_SECRET to its signing secret. Returning an
// error makes Stripe retry, so only database failures do.
func (h *Handler) Webhook(c echo.Context) error {
	payload, err := io.ReadAll(c.Request().Body)
	if err != nil {
		return echo.NewHTTPError(http.StatusBadRequest, "unreadable body")
	}
	event, err := webhook.ConstructEventWithOptions(
		payload,
		c.Request().Header.Get("Stripe-Signature"),
		os.Getenv("STRIPE_WEBHOOK_SECRET"),
		webhook.ConstructEventOptions{IgnoreAPIVersionMismatch: true},
	)
	if err != nil {
		return echo.NewHTTPError(http.StatusBadRequest, "signature verification failed")
	}

	ctx := c.Request().Context()
	switch event.Type {
	case "checkout.session.completed":
		var sess stripesdk.CheckoutSession
		if err := json.Unmarshal(event.Data.Raw, &sess); err != nil {
			return echo.NewHTTPError(http.StatusBadRequest, "malformed event")
		}
		if sess.Subscription != nil {
			full, err := subscription.Get(sess.Subscription.ID, nil)
			if err != nil {
				return err
			}
			if err := h.syncSubscription(ctx, full); err != nil {
				return err
			}
		}
	case "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted":
		var sub stripesdk.Subscription
		if err := json.Unmarshal(event.Data.Raw, &sub); err != nil {
			return echo.NewHTTPError(http.StatusBadRequest, "malformed event")
		}
		if err := h.syncSubscription(ctx, &sub); err != nil {
			return err
		}
	}
	return c.NoContent(http.StatusOK)
}

// syncSubscription mirrors a Stripe subscription into the row keyed by its
// customer. Events for customers this app never created are ignored.
func (h *Handler) syncSubscription(ctx context.Context, sub *stripesdk.Subscription) error {
	if sub.Customer == nil {
		return nil
	}
	params := dbgen.SyncSubscriptionParams{
		StripeCustomerID:     sub.Customer.ID,
		StripeSubscriptionID: &sub.ID,
		Status:               string(sub.Status),
		CancelAtPeriodEnd:    sub.CancelAtPeriodEnd,
	}
	if sub.Items != nil && len(sub.Items.Data) > 0 {
		item := sub.Items.Data[0]
		if item.Price != nil {
			params.PriceID = &item.Price.ID
		}
		if item.CurrentPeriodEnd > 0 {
			end := time.Unix(item.CurrentPeriodEnd, 0).UTC()
			params.CurrentPeriodEnd = &end
		}
	}
	_, err := h.q.SyncSubscription(ctx, params)
	if errors.Is(err, pgx.ErrNoRows) {
		return nil
	}
	return err
}
